# ==========================================
# SUPABASE EDGE FUNCTIONS ENVIRONMENT VARIABLES
# ==========================================
# Add your real API keys here before deploying the functions.
# Deploy with: supabase secrets set --env-file ./supabase/.env.local

# MSG91 Credentials
# Get these from your MSG91 Dashboard -> Developers -> API Keys
MSG91_AUTH_KEY="your_msg91_auth_key_here"
MSG91_TEMPLATE_ID="your_msg91_sms_template_id_here"

# (Optional) MSG91 Sender ID if required for your template
MSG91_SENDER_ID="your_sender_id_here"
