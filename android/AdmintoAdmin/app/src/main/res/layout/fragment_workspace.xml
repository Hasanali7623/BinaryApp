<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 2 OF 4"
            style="@style/BadgeBlue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_workspace"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvStep" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Establish your dedicated portal where your team will collaborate securely."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Preview Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvDesc">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                
                <TextView
                    android:id="@+id/tvPreviewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORKSPACE PREVIEW"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/icBrowser"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_business"
                    app:tint="@color/neon_blue"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tvPreviewLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvPreviewName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Acme Technologies"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/icBrowser"
                    app:layout_constraintStart_toEndOf="@id/icBrowser" />

                <TextView
                    android:id="@+id/tvUrlPreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="acme.binaryapp.io"
                    android:textColor="@color/success_green"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/tvPreviewName"
                    app:layout_constraintStart_toEndOf="@id/icBrowser" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWorkspaceName"
            style="@style/AdminInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Workspace Name"
            app:layout_constraintTop_toBottomOf="@id/tvDesc"
            app:layout_goneMarginTop="160dp"> <!-- Fallback -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkspaceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWorkspaceUrl"
            style="@style/AdminInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Workspace URL"
            app:suffixText=".binaryapp.io"
            app:suffixTextColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tilWorkspaceName">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkspaceUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvDomainLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL DOMAIN BINDING"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tilWorkspaceUrl"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvDomainDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Link your organization's email domain to automatically route users to this workspace."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvDomainLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilOrgDomain"
            style="@style/AdminInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Organization Domain (e.g., @company.com)"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tvDomainDesc">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOrgDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateWorkspace"
            style="@style/GlowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Workspace →"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tilOrgDomain" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnCreateWorkspace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDraft"
            style="@style/OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_draft"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnCreateWorkspace" />

        <!-- Used for invisible anchoring -->
        <TextView android:id="@+id/tvPreviewOrg" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
