<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 4 OF 4"
            style="@style/BadgeBlue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configure_security"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvStep" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set the baseline security policies for all users in your organization."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSecurity"
            style="@style/GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvDesc">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTHENTICATION POLICIES"
                    android:textColor="@color/neon_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- MFA -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMfa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Require Multi-Factor Auth (MFA)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/input_border"
                    android:layout_marginBottom="12dp" />

                <!-- Password Rotation -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPasswordRotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enforce 90-day Password Rotation"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/input_border"
                    android:layout_marginBottom="12dp" />

                <!-- Biometric -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBiometric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow Biometric Login (Mobile)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/input_border"
                    android:layout_marginBottom="24dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCESS CONTROLS"
                    android:textColor="@color/neon_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Device Trust -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDeviceTrust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Device Trust Verification"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/input_border"
                    android:layout_marginBottom="12dp" />

                <!-- IP Restrictions -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchIpRestrictions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Restrict Login to Corporate IPs"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/input_border"
                    android:layout_marginBottom="12dp" />

                <!-- Login Monitoring -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLoginMonitoring"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Suspicious Login Monitoring"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/input_border"
                    android:layout_marginBottom="24dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PARAMETERS"
                    android:textColor="@color/neon_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Session Idle Timeout"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSessionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 Minutes"
                        android:textColor="@color/neon_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSessionTimeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="15"
                    android:valueTo="120"
                    android:value="30"
                    android:stepSize="15"
                    app:thumbTint="@color/neon_blue"
                    app:trackColorActive="@color/neon_blue"
                    app:trackColorInactive="@color/glass_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Min. Password Length"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvMinLengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 Characters"
                        android:textColor="@color/neon_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMinLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="8"
                    android:valueTo="24"
                    android:value="12"
                    android:stepSize="1"
                    app:thumbTint="@color/neon_blue"
                    app:trackColorActive="@color/neon_blue"
                    app:trackColorInactive="@color/glass_border" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyPolicies"
            style="@style/GlowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apply_security_policies"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/cardSecurity" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnApplyPolicies"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvViewDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply Recommended Defaults"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnApplyPolicies"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
