<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <View
        android:id="@+id/glassBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_card"
        android:layout_margin="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Verify OTP"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/glassBackground"
        app:layout_constraintStart_toStartOf="@id/glassBackground"
        app:layout_constraintTop_toTopOf="@id/glassBackground" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:text="We sent a secure code to your SMS Messages."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/glassBackground"
        app:layout_constraintStart_toStartOf="@id/glassBackground"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilOtp"
        style="@style/GlowInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="@id/glassBackground"
        app:layout_constraintStart_toStartOf="@id/glassBackground"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter 6-digit Code"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminateTint="@color/neon_blue"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/glassBackground"
        app:layout_constraintStart_toStartOf="@id/glassBackground"
        app:layout_constraintTop_toBottomOf="@id/tilOtp" />

    <Button
        android:id="@+id/btnVerifyOtp"
        style="@style/GlowButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:text="Verify &amp; Login"
        app:layout_constraintEnd_toEndOf="@id/glassBackground"
        app:layout_constraintStart_toStartOf="@id/glassBackground"
        app:layout_constraintTop_toBottomOf="@id/tilOtp" />

    <TextView
        android:id="@+id/btnResendOtp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:text="Resend OTP"
        android:textColor="@color/neon_blue"
        app:layout_constraintEnd_toEndOf="@id/glassBackground"
        app:layout_constraintStart_toStartOf="@id/glassBackground"
        app:layout_constraintTop_toBottomOf="@id/btnVerifyOtp" />

</androidx.constraintlayout.widget.ConstraintLayout>
